<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    
    <uses-permission android:name="com.nuttyvr.permission.MODS" />
    <uses-permission android:name="com.nuttyvr.permission.ROOT_STATUS" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.vr.headtracking" android:version="1" android:required="false" />
    <queries><package android:name="com.nuttyvr.hub" /><package android:name="com.nuttyvr.loader" /><package android:name="com.nuttyvr.rootmode" /><package android:name="com.nuttyvr.rootmodelib" /><package android:name="com.nuttyvr.nuttymod" /><package android:name="com.nuttyvr.vnedruntime" /><package android:name="com.nuttyvr.nuttymodruntime" /><package android:name="com.nuttyvr.demo" /><package android:name="com.beatgames.beatsaber" /></queries>
    <application android:label="Root Mode" android:icon="@drawable/ic_nutty" android:theme="@style/AppTheme"
        android:allowBackup="false" android:fullBackupContent="false" android:hardwareAccelerated="true" android:supportsRtl="true">
        <meta-data android:name="com.oculus.supportedDevices" android:value="quest2|questpro|quest3|quest3s" />
        <activity android:name="com.nuttyvr.common.MainActivity" android:exported="true" android:resizeableActivity="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden">
            <layout android:defaultWidth="1000dp" android:defaultHeight="720dp" android:minWidth="480dp" android:minHeight="360dp" />
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        
    </application>
</manifest>
